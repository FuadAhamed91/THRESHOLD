# THRESHOLD server configuration.
# Copy to server/.env (gitignored) and fill in what you need. Variables already set in the
# real environment take precedence over this file. Empty values count as unset.
# With nothing set, the server runs in simulation mode.

# --- Ring API auth: use ONE mode (setting both tokens is a configuration error) ---------
# Mode 1: access token from the Ring developer Playground (expires after ~30 minutes).
RING_ACCESS_TOKEN=
# Mode 2: refresh token + client credentials. Ring returns a new refresh token on every
# refresh and invalidates the old one; the server keeps the new one in memory only, so
# put a fresh refresh token here before each restart.
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
# Optional: device shown in /api/integration/status (default: first device on the account).
RING_DEVICE_ID=

# --- Webhooks -----------------------------------------------------------------------------
# Partner HMAC signing key used to verify X-Signature on incoming Ring webhooks.
RING_WEBHOOK_SIGNING_KEY=
# Local development only: accept unsigned webhooks when no signing key is set
# (events are marked signatureVerified=false). Ignored when a signing key is set.
THRESHOLD_ALLOW_UNSIGNED_WEBHOOKS=false

# --- Server -------------------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS.
THRESHOLD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Port for `python -m threshold_server.main` (the uvicorn CLI uses its own --port flag).
THRESHOLD_PORT=8787
